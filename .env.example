# Server-only credentials for the protected admin console.
# Create a Firebase service account and keep this private key off the client.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
ADMIN_EMAILS=

# MoonPay publishable key is safe to expose to the browser.
NEXT_PUBLIC_MOONPAY_API_KEY=
NEXT_PUBLIC_MOONPAY_ENVIRONMENT=sandbox

# Keep this secret server-side. Never prefix it with NEXT_PUBLIC_.
MOONPAY_SECRET_KEY=

# Keep the Uniswap Trading API key server-side.
UNISWAP_API_KEY=
